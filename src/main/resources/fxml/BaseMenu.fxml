<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="600.0" minWidth="900.0" prefHeight="700.0" prefWidth="1300.0" style="-fx-background-color: #F3F9FF; -fx-font-family: 'Segoe UI', Arial, sans-serif;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="UI.BaseMenuController">

   <!-- ========== MENÚ LATERAL ========== -->
   <left>
      <VBox prefWidth="230.0" spacing="0.0" style="-fx-background-color: linear-gradient(to bottom, #0F4C81, #0B3A66); -fx-background-radius: 0 0 35 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="24.0" left="14.0" right="0.0" top="30.0" />
         </padding>
         <children>
            <VBox alignment="CENTER" spacing="6.0" style="-fx-padding: 0 14 0 0;">
               <children>
                  <Label fx:id="lblLogo" alignment="CENTER" prefHeight="78.0" prefWidth="78.0" style="-fx-background-color: linear-gradient(to bottom right, #38BDF8, #0070F3); -fx-background-insets: 6; -fx-background-radius: 39; -fx-border-color: #F59E0B; -fx-border-width: 2; -fx-border-radius: 39; -fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold; -fx-cursor: hand;" text="A" />
                  <Label style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="ANTBUDDY" />
                  <Label style="-fx-text-fill: #93C5FD; -fx-font-size: 11px;" text="Mi almacén" />
               </children>
            </VBox>
            <Region prefHeight="22.0" />

            <Button fx:id="btnInventario" maxWidth="Infinity" minHeight="72.0" mnemonicParsing="false" onAction="#handleInventario" prefHeight="72.0" style="-fx-shape: 'M 24,12 L 204,12 A 12,12 0 0 0 216,0 L 216,72 A 12,12 0 0 0 204,60 L 24,60 A 24,24 0 0 1 0,36 A 24,24 0 0 1 24,12 Z'; -fx-background-color: white; -fx-text-fill: #0B3A66; -fx-alignment: CENTER-LEFT; -fx-padding: 0 16 0 24; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;" text="▤   Inventario" />
            <Button fx:id="btnCategorias" maxWidth="Infinity" minHeight="72.0" mnemonicParsing="false" onAction="#handleCategorias" prefHeight="72.0" style="-fx-shape: 'M 24,12 L 204,12 A 12,12 0 0 0 216,0 L 216,72 A 12,12 0 0 0 204,60 L 24,60 A 24,24 0 0 1 0,36 A 24,24 0 0 1 24,12 Z'; -fx-background-color: transparent; -fx-text-fill: #BFDBFE; -fx-alignment: CENTER-LEFT; -fx-padding: 0 16 0 24; -fx-font-size: 14px; -fx-font-weight: normal; -fx-cursor: hand;" text="◈   Categorías" />
            <Button fx:id="btnMovimientos" maxWidth="Infinity" minHeight="72.0" mnemonicParsing="false" onAction="#handleMovimientos" prefHeight="72.0" style="-fx-shape: 'M 24,12 L 204,12 A 12,12 0 0 0 216,0 L 216,72 A 12,12 0 0 0 204,60 L 24,60 A 24,24 0 0 1 0,36 A 24,24 0 0 1 24,12 Z'; -fx-background-color: transparent; -fx-text-fill: #BFDBFE; -fx-alignment: CENTER-LEFT; -fx-padding: 0 16 0 24; -fx-font-size: 14px; -fx-font-weight: normal; -fx-cursor: hand;" text="⇄   Movimientos" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="btnSalir" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSalir" style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: #FECACA; -fx-alignment: CENTER-LEFT; -fx-padding: 14 16 14 22; -fx-background-radius: 30 0 0 30; -fx-font-size: 14px; -fx-font-weight: normal; -fx-cursor: hand;" text="⏻   Salir" />
         </children>
      </VBox>
   </left>

   <!-- ========== ZONA DE CONTENIDO (aquí se cargan las pantallas) ========== -->
   <center>
      <StackPane fx:id="contentArea" style="-fx-background-color: #FFFFFF;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-size: 16px; -fx-text-fill: #64748B; -fx-background-color: #ffffff;" text="Selecciona una opción del menú" />
         </children>
      </StackPane>
   </center>
   <top>
      <HBox prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #0F4C81;" BorderPane.alignment="CENTER" />
   </top>
</BorderPane>
